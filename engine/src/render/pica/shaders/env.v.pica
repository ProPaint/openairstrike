; env.v.pica: environment-mapped models (M3.4). mesh.v.pica (position, baked ambient-cube light,
; skin uv) plus texcoord1 = the environment map coordinate of the GL mesh vertex shader
; (engine/src/render/gles/shaders.cpp kMeshVertexSrc, as3d/envmap.h):
;   n   = the folded model normal |n| (v4, u8 x3 = |n| * 255, stored by GpuMesh::upload for
;         smooth-normal meshes only)
;   ne  = nmat * n                      (nmat: 3 rows, set by the CPU per draw)
;   GL_SPHERE_MAP (the first game): nmat = envNormalMatrix(view, model) (inverse transpose of
;         the modelview, not renormalised), u = normalize(mv * pos), r = u - 2 ne (ne . u),
;         st = r.xy / (2 sqrt(r.x^2 + r.y^2 + (r.z + 1)^2)) + 0.5 = r.xy * 0.5 rsq(q) + 0.5
;   view normal (the sequels, as2 delta 4.3): nmat = mat3(view) * mat3(model), st = 0.5 + 0.5 ne.xy
;   both computed, selected by envsel = (0.5, 0, ., .) view normal or (0, 1, ., .) sphere map:
;         st = 0.5 + envsel.x * ne.xy + envsel.y * r.xy / m
;   ENV_QUAD: st' = (dot(envrot[0], st), dot(envrot[1], st)), the rotation by time * 30 degrees
;         about the texture origin (identity rows for the other modes).
;   v0 position  float x3     (stream 0, pica::MeshVertex)
;   v1 wPos      u8 x4
;   v2 wNeg      u8 x4
;   v3 texcoord  float x2
;   v4 normal    u8 x4        (stream 1: |n.x|, |n.y|, |n.z|, 0) * 255
; Uniforms: mvp, cube[6], tint as mesh.v.pica; mv (rows 0..2 of view * model); nmat[3];
; envsel; envrot[2].

.fvec mvp[4]
.fvec cube[6]
.fvec tint
.fvec mv[3]
.fvec nmat[3]
.fvec envsel
.fvec envrot[2]

.constf consts(0.0, 1.0, 0.00392156862, 0.5)
.constf consts2(1e-12, 0.0, 0.0, 0.0)
.alias zeros consts.xxxx
.alias ones consts.yyyy
.alias inv255 consts.zzzz
.alias half consts.wwww
.alias tiny consts2.xxxx

.out outpos position
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outclr color

.alias inpos v0
.alias inwp v1
.alias inwn v2
.alias intex v3
.alias innrm v4

.proc main
	mov r0.xyz, inpos
	mov r0.w, ones
	dp4 outpos.x, mvp[0], r0
	dp4 outpos.y, mvp[1], r0
	dp4 outpos.z, mvp[2], r0
	dp4 outpos.w, mvp[3], r0
	mov outtc0, intex

	; the light, as mesh.v.pica
	mul r1, inv255, inwp
	mul r2, inv255, inwn
	mul r3, cube[0], r1.xxxx
	mad r3, r1.yyyy, cube[1], r3
	mad r3, r1.zzzz, cube[2], r3
	mad r3, r2.xxxx, cube[3], r3
	mad r3, r2.yyyy, cube[4], r3
	mad r3, r2.zzzz, cube[5], r3
	max r3, zeros, r3
	min r3, ones, r3
	mov r3.w, ones
	mul outclr, tint, r3

	; ne = nmat * |n|
	mul r4, inv255, innrm
	dp3 r5.x, nmat[0], r4
	dp3 r5.y, nmat[1], r4
	dp3 r5.z, nmat[2], r4
	; u = normalize(eye position)
	dp4 r6.x, mv[0], r0
	dp4 r6.y, mv[1], r0
	dp4 r6.z, mv[2], r0
	mov r6.w, zeros
	dp3 r7.x, r6, r6
	max r7.x, tiny, r7.x
	rsq r7.x, r7.x
	mul r6, r7.xxxx, r6
	; r = u - 2 ne (ne . u)
	dp3 r7.x, r5, r6
	add r7.x, r7.x, r7.x
	mul r8, r7.xxxx, r5
	add r8, r6, -r8
	; q = r.x^2 + r.y^2 + (r.z + 1)^2; r.xy / m = r.xy * 0.5 rsq(q)
	add r8.z, ones, r8.z
	mov r8.w, zeros
	dp3 r9.x, r8, r8
	max r9.x, tiny, r9.x
	rsq r9.x, r9.x
	mul r9.x, half, r9.x
	mul r8, r9.xxxx, r8
	; st = 0.5 + envsel.x * ne.xy + envsel.y * r.xy / m, then the ENV_QUAD rotation
	mul r10, envsel.xxxx, r5
	mad r10, r8, envsel.yyyy, r10
	add r10, half, r10
	mov r10.zw, zeros
	dp4 outtc1.x, envrot[0], r10
	dp4 outtc1.y, envrot[1], r10
	mov outtc1.zw, zeros
	end
.end
